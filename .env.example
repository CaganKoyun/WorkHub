# Supabase — connect to your Supabase project
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auth0 (SPA) — provisioned via the Vercel Auth0 integration.
# Domain is the tenant domain, e.g. icfg-xxxxxx.us.auth0.com (no https://).
VITE_AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_SPA_CLIENT_ID

# Optional: Auth0 API audience.
# Set this to the Identifier of an Auth0 API so getAccessTokenSilently()
# returns a JWT access token that Supabase third-party auth can verify.
# Without an audience, Auth0 returns an opaque token and Supabase RLS will
# reject requests. Create an API in Auth0 Dashboard → Applications → APIs,
# then paste its Identifier here.
# VITE_AUTH0_AUDIENCE=https://your-api-identifier
