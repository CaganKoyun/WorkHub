# WorkHub environment variables.
# ------------------------------------------------------------------
# Copy this file to `.env.local` for local dev; mirror the same keys
# in Vercel → Project Settings → Environment Variables for prod.
# Only `VITE_*` keys are exposed to the browser bundle. Everything
# else lives in Supabase Edge Function secrets.
# ------------------------------------------------------------------

# --- Supabase (required) ------------------------------------------
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# --- Auth0 (required) --------------------------------------------
VITE_AUTH0_DOMAIN="YOUR_TENANT.auth0.com"
VITE_AUTH0_CLIENT_ID=""
# Optional: set an API audience for access tokens instead of id_tokens
# VITE_AUTH0_AUDIENCE=""

# --- Web Push (optional; Phase 7.2) -------------------------------
# Generate a key pair with `npx web-push generate-vapid-keys`.
# Public key ships in the client bundle. Private key stays in Supabase
# Edge Function secrets as VAPID_PRIVATE_KEY (see below).
VITE_VAPID_PUBLIC_KEY=""

# ------------------------------------------------------------------
# The following are NOT read by the client — they belong in
# Supabase → Edge Functions → Secrets. Listed here only as a
# checklist for the workspace owner.
# ------------------------------------------------------------------
#
# send-push (VAPID)
#   VAPID_PRIVATE_KEY=""
#   VAPID_SUBJECT="mailto:you@yourdomain.com"
#
# send-email (Resend — Phase 10.4)
#   RESEND_API_KEY=""
#   EMAIL_FROM="WorkHub <alerts@yourdomain.com>"
#
# Billing (Phase 10.6 — Stripe hook-up, not yet implemented)
#   STRIPE_SECRET_KEY=""
#   STRIPE_WEBHOOK_SECRET=""
#   STRIPE_PORTAL_URL=""
