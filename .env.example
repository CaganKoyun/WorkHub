# Supabase — connect to your Supabase project
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Auth0 (SPA) — provisioned via the Vercel Auth0 integration.
# Domain is the tenant domain, e.g. icfg-xxxxxx.us.auth0.com (no https://).
VITE_AUTH0_DOMAIN=YOUR-TENANT.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_AUTH0_SPA_CLIENT_ID

# Optional: Auth0 API audience.
# If set, the app calls getAccessTokenSilently() with this audience and sends
# the resulting JWT access token to Supabase. If unset, the app falls back to
# the Auth0 id_token — which is always a JWT and works without an Auth0 API,
# so leaving this blank is fine for a basic setup.
# VITE_AUTH0_AUDIENCE=https://your-api-identifier
